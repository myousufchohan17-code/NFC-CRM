# CRM dashboard — must use the SAME database as the Digital Menu (restaurantorder)
# Local (SQLite): change provider to "sqlite" in prisma/schema.prisma
# DATABASE_URL="file:./dev.db"
#
# Production (PostgreSQL) — required for Vercel:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
# Deployed Digital Menu URL
NEXT_PUBLIC_SITE_URL="https://frontend-pi-eight-49.vercel.app"
